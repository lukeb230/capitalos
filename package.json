{
  "name": "capitalos",
  "version": "1.0.9",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "electron:dev": "concurrently \"next dev --webpack\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:backup": "rm -rf ~/Desktop/capitalos-last-working-backup && cp -R . ~/Desktop/capitalos-last-working-backup && rm -rf ~/Desktop/capitalos-last-working-backup/node_modules ~/Desktop/capitalos-last-working-backup/.next ~/Desktop/capitalos-last-working-backup/dist",
    "electron:build": "npm run electron:backup && next build --webpack && electron-builder",
    "electron:start": "electron ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "com.capitalos.app",
    "productName": "CapitalOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      "public/**/*",
      "package.json",
      ".env"
    ],
    "asarUnpack": [
      ".next/**/*",
      ".env",
      "prisma/**/*",
      "public/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "lukeb230",
      "repo": "capitalos"
    },
    "mac": {
      "target": "zip",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "pdfjs-dist": "^5.6.205",
    "plaid": "^41.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-plaid-link": "^4.1.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "wait-on": "^8.0.4"
  }
}
